# What the image does not need. The context is this checkout, and two things in
# it must never travel: the build output of another machine and the `.env`.
.git
.github
node_modules
.nuxt
.nitro
.output
.cache
dist
.data

# Copies of a host's data directory, taken by every deploy.
backups
backup

# Logs.
logs
*.log

# Runtime data. The container keeps its own in the `hoa-data` volume, and a
# copy of a developer's database has no business inside an image.
server/data

# Configuration, supplied to the container by `docker-compose.yml` at run time
# so the credentials are never baked into a layer.
.env
.env.*
!.env.example

# Tests are not part of a build.
test
vitest.config.ts
vitest.bench.config.ts
