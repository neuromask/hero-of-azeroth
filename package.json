{
  "name": "hero-of-azeroth",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:ftp": "node scripts/deploy.mjs --no-build --no-github",
    "deploy:github": "node scripts/deploy.mjs --no-build --no-ftp",
    "dev": "node scripts/check-dev-port.mjs 3100 && nuxt dev --port 3100",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 3100",
    "postinstall": "nuxt prepare",
    "refresh:achievements": "node scripts/refresh-achievement-points.mjs",
    "refresh:achievements-atlas": "node scripts/refresh-collections.mjs --only=achievements",
    "refresh:achievement-meta": "node scripts/refresh-achievement-meta.mjs",
    "refresh:armoury-totals": "node scripts/refresh-armoury-totals.mjs",
  "refresh:all": "node scripts/refresh-all.mjs",
    "refresh:collections": "node scripts/refresh-collections.mjs",
    "refresh:reputations": "node scripts/refresh-reputation-totals.mjs"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "jpeg-js": "^0.4.4",
    "nuxt": "^4.5.2",
    "sharp": "^0.35.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.4",
    "@img/sharp-linux-x64": "^0.35.5",
    "@resvg/resvg-js-linux-x64-gnu": "^2.6.2"
  }
}
